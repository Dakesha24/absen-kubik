DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
# Base64-encoded 32-byte key for encrypting admin settings. Keep it stable and private.
SETTINGS_ENCRYPTION_KEY=
# Optional. Must be compatible with the Nominatim reverse endpoint.
GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse

# Google Drive OAuth credentials. Keep these server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional folder ID. If omitted, the app creates ABSEN-KUBIK in the Drive root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Used once by `npm run db:bootstrap-admin` to create the first admin account.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@kubik.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-use
